# Node.js backend only. Keep the existing Atlas database; never use NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://<username>:<password>@<hostname>/<existing-database>?retryWrites=true&w=majority
# Optional: override the database in the URI (otherwise it is preserved).
# MONGODB_DB=ecom_shop_db
APP_ENV=development
ALLOW_SEED=false
# Optional backend listen address (defaults: 127.0.0.1:8000; 0.0.0.0 when APP_ENV=production).
# PORT=8000
# HOST=127.0.0.1

# Next.js server -> Node.js API. Copy BACKEND_API_KEY to both hosts.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_KEY=
# Set both on Netlify to enable protected administration.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Razorpay Credentials (get from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Explicit read-only storefront preview; never pretends to save to MongoDB.
DEMO_MODE=false
